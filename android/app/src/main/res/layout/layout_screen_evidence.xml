<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenEvidence"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header with Back Arrow -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBackEvidence"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Evidence Capture"
                android:textColor="@color/text_primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Auto-saving securely status pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Auto-saving securely"
                android:textColor="@color/safety_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2x2 Grid of Evidence Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- Row 1: Audio Recording & Video -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="horizontal">

                <!-- 1. Audio Recording Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_evidence_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Recording"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_circle_num_red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Recording..."
                            android:textColor="@color/emergency_red"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Waveform simulation container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_waveform_container"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="16dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="22dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="@color/emergency_red" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEvidenceAudioDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="00:02:14"
                        android:textColor="@color/text_secondary_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 2. Video Thumbnail Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_evidence_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Simulated video camera preview -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:background="#334155">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="6dp"
                            android:text="CAM-01 (1080p)"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Photos & Background Data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- 3. Photos Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_evidence_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photos"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 captured"
                        android:textColor="@color/text_secondary_muted"
                        android:textSize="10sp" />

                    <!-- Photo preview thumbnail -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:background="#475569">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_car" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 4. Background Data Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_evidence_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Background Data"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location, sensors, device info"
                        android:textColor="@color/text_secondary_muted"
                        android:textSize="10sp" />

                    <!-- Telemetry Document Icon -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:background="#F1F5F9">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_document" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Cryptographic Vault Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamper-Evident Security Log"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEvidenceVaultInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="• AES-256-GCM Hardware Encrypted\n• SHA-256 Merkle Chain: 9a3f...d8c2\n• Geo-tagged at 12.9716° N, 77.5946° E"
                android:textColor="@color/text_secondary_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
