<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Quick Demo Bar / Screen Switcher (Allows instant preview of all 12 screens) -->
    <LinearLayout
        android:id="@+id/quickScreenSwitcherBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#0F172A"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <Button
                    android:id="@+id/chipScreen1"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="1. Welcome"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/brand_blue"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="2. Home"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen3"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/emergency_red"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="3. Trigger"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen4"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="4. Types"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen5"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="5. Incident"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen6"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="6. Contacts"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen7"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="7. Detection"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen8"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="8. Evidence"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen9"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="9. Responder"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen10"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="10. Timeline"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen11"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="11. Summary"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipScreen12"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="12. Settings"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Screens Container holding all 12 screen layouts -->
    <FrameLayout
        android:id="@+id/screensContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/quickScreenSwitcherBar">

        <!-- 1. Welcome / Onboarding Screen -->
        <include
            android:id="@+id/viewScreen1Onboarding"
            layout="@layout/layout_screen_onboarding"
            android:visibility="gone" />

        <!-- 2. Home Dashboard Screen (Default Visible) -->
        <include
            android:id="@+id/viewScreen2Home"
            layout="@layout/layout_screen_home"
            android:visibility="visible" />

        <!-- 3. Emergency Trigger Screen -->
        <include
            android:id="@+id/viewScreen3Trigger"
            layout="@layout/layout_screen_trigger"
            android:visibility="gone" />

        <!-- 4. Emergency Type Selection Screen -->
        <include
            android:id="@+id/viewScreen4Types"
            layout="@layout/layout_screen_types"
            android:visibility="gone" />

        <!-- 5. Live Incident Screen -->
        <include
            android:id="@+id/viewScreen5Incident"
            layout="@layout/layout_screen_incident"
            android:visibility="gone" />

        <!-- 6. Contacts & Family Screen -->
        <include
            android:id="@+id/viewScreen6Contacts"
            layout="@layout/layout_screen_contacts"
            android:visibility="gone" />

        <!-- 7. Automatic Detection Alert Screen -->
        <include
            android:id="@+id/viewScreen7CrashAlert"
            layout="@layout/layout_screen_crash_alert"
            android:visibility="gone" />

        <!-- 8. Evidence Capture Screen -->
        <include
            android:id="@+id/viewScreen8Evidence"
            layout="@layout/layout_screen_evidence"
            android:visibility="gone" />

        <!-- 9. Responder View Screen -->
        <include
            android:id="@+id/viewScreen9Responder"
            layout="@layout/layout_screen_responder"
            android:visibility="gone" />

        <!-- 10. Live Timeline Screen -->
        <include
            android:id="@+id/viewScreen10Timeline"
            layout="@layout/layout_screen_timeline"
            android:visibility="gone" />

        <!-- 11. Post-Incident Summary Screen -->
        <include
            android:id="@+id/viewScreen11Summary"
            layout="@layout/layout_screen_summary"
            android:visibility="gone" />

        <!-- 12. Settings & Preferences Screen -->
        <include
            android:id="@+id/viewScreen12Settings"
            layout="@layout/layout_screen_settings"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Navigation Bar (Home, Contacts, Timeline, More) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_white"
        app:elevation="8dp"
        app:itemIconTint="@color/brand_blue"
        app:itemTextColor="@color/text_primary_dark"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
