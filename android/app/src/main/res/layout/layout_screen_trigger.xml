<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenTrigger"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Top Titles -->
    <LinearLayout
        android:id="@+id/containerTriggerTitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Activated"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We're getting you help"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Concentric Glowing Rings and Pulsing SOS Triangle -->
    <FrameLayout
        android:id="@+id/containerPulseRings"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true">

        <!-- Outer Glowing Ring -->
        <View
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_gravity="center"
            android:alpha="0.3"
            android:background="@drawable/bg_circle_num_red" />

        <!-- Middle Ring -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:alpha="0.5"
            android:background="@drawable/bg_circle_num_red" />

        <!-- Inner Solid Ring -->
        <FrameLayout
            android:id="@+id/btnPulseCenter"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_num_red">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning_triangle" />
        </FrameLayout>
    </FrameLayout>

    <!-- Countdown Timer Number inside Circular Ring -->
    <FrameLayout
        android:id="@+id/badgeCountdown"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_below="@id/containerPulseRings"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_countdown_circle">

        <TextView
            android:id="@+id/tvTriggerCountdownNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Bottom Cancel Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btnCancelEmergencyTrigger"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_cancel_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
