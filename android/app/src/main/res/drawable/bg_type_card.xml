<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FEF2F2" />
            <stroke android:width="2dp" android:color="@color/emergency_red" />
            <corners android:radius="14dp" />
            <padding android:bottom="14dp" android:left="12dp" android:right="12dp" android:top="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <stroke android:width="1dp" android:color="@color/card_stroke_light" />
            <corners android:radius="14dp" />
            <padding android:bottom="14dp" android:left="12dp" android:right="12dp" android:top="14dp" />
        </shape>
    </item>
</selector>
